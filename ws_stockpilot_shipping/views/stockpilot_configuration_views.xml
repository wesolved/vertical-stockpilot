<odoo>
    <record id="view_stockpilot_configuration_form" model="ir.ui.view">
        <field name="model">stockpilot.configuration</field>
        <field name="inherit_id" ref="ws_stockpilot_connector.view_stockpilot_configuration_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='active']" position="after">
                <field name="shipping_method_ids">
                    <list editable="bottom">
                        <field name="stockpilot_name" />
                        <field name="carrier_id" />
                    </list>
                </field>
            </xpath>
        </field>
    </record>
</odoo>
