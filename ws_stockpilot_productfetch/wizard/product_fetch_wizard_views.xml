<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="view_product_fetch_wizard_form" model="ir.ui.view">
            <field name="name">product.fetch.wizard.form</field>
            <field name="model">product.fetch.wizard</field>
            <field name="arch" type="xml">
                <form string="Fetch Products from Stockpilot">
                    <group>
                        <field name="configuration_id" readonly="1" />
                        <field name="page_size" />
                        <field name="fetch_all_pages" />
                        <field name="max_pages" invisible="fetch_all_pages" />
                        <field name="state" invisible="1" />
                    </group>
                    
                    <group invisible="state not in ['done', 'error']">
                        <field name="products_fetched" readonly="1" />
                        <field name="total_products" readonly="1" />
                        <field name="error_message" readonly="1" invisible="state != 'error'" />
                    </group>
                    
                    <footer>
                        <button 
                            name="action_fetch_products" 
                            string="Fetch Products" 
                            type="object" 
                            class="btn-primary"
                            invisible="state != 'draft'" />
                        <button 
                            name="action_close" 
                            string="Close" 
                            type="object" 
                            class="btn-secondary" />
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
