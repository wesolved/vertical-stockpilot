        <field name="name">Fetch Stockpilot Orders</field>
        <field name="model_id" ref="model_stockpilot_sync" />
        <field name="state">code</field>
        <field name="code">model._fetch_stockpilot_orders()</field>
        <field name="interval_number">2</field>
