<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="ir_cron_fetch_stockpilot_orders" model="ir.cron">
        <field name="name">Fetch Stockpilot Orders</field>
        <field name="model_id" ref="model_stockpilot_sync" />
        <field name="state">code</field>
        <field name="code">model._fetch_stockpilot_orders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_stockpilot_full_sync" model="ir.cron">
        <field name="name">Stockpilot Full Inventory Sync</field>
        <field name="model_id" ref="model_stockpilot_inventory" />
        <field name="state">code</field>
        <field name="code">model._scheduled_full_sync()</field>
        <field name="interval_number">6</field>
        <field name="interval_type">hours</field>
        <field name="active">False</field>
    </record>
</odoo>
