<odoo>
    <record id="product_product_tree_view" model="ir.ui.view">
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_product_tree_view" />
            <field name="arch" type="xml">
                <field name="type" position="after">
                    <field name="exported_to_stockpilot" />
                    <field name="stockpilot_id" />
                    <field name="stockpilot_config_id" />
                </field>
            </field>
        </record>



    <record id="action_export_to_stockpilot" model="ir.actions.server">
            <field name="name">Export to stockpilot</field>
            <field name="model_id" ref="product.model_product_product" />
            <field name="binding_model_id" ref="product.model_product_product" />
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
            if records:
                config = env["stockpilot.configuration"].get_config()
                if config:
                    for rec in records:
                        env["stockpilot.inventory"].with_context(stockpilot_config=config).with_delay()._trigger_stock_update(rec)
                else:
                    raise UserError("No Stockpilot configuration found")
            </field>
        </record>
</odoo>
