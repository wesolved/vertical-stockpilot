<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <!-- Batch Export Tree View -->
        <record id="view_stockpilot_batch_export_tree" model="ir.ui.view">
            <field name="name">stockpilot.batch.export.tree</field>
            <field name="model">stockpilot.batch.export</field>
            <field name="arch" type="xml">
                <tree string="Batch Exports">
                    <field name="name" />
                    <field name="config_id" />
                    <field name="company_id" />
                    <field name="job_batch_id" />
                    <field name="create_date" />
                </tree>
            </field>
        </record>

        <!-- Batch Export Form View -->
        <record id="view_stockpilot_batch_export_form" model="ir.ui.view">
            <field name="name">stockpilot.batch.export.form</field>
            <field name="model">stockpilot.batch.export</field>
            <field name="arch" type="xml">
                <form string="Batch Export">
                    <header>
                        <button name="action_start_export" string="Start Export" type="object" class="oe_highlight" />
                        <button name="action_view_job_batch" string="View Job Batch" type="object" class="btn-secondary" />
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Batch Export Name" />
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="config_id" />
                                <field name="company_id" />
                                <field name="create_date" />
                            </group>
                            <group>
                                <field name="job_batch_id" />
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Batch Export Kanban View -->
        <record id="view_stockpilot_batch_export_kanban" model="ir.ui.view">
            <field name="name">stockpilot.batch.export.kanban</field>
            <field name="model">stockpilot.batch.export</field>
            <field name="arch" type="xml">
                <kanban default_group_by="company_id" class="o_kanban_small_column">
                    <field name="name" />
                    <field name="job_batch_id" />
                    <field name="create_date" />
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click">
                                <div class="oe_kanban_content">
                                    <div class="o_kanban_record_top">
                                        <div class="o_kanban_record_headings">
                                            <strong class="o_kanban_record_title">
                                                <field name="name" />
                                            </strong>
                                        </div>
                                        <div class="o_kanban_record_bottom">
                                            <div class="oe_kanban_bottom_left">
                                                <field name="job_batch_id" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="o_kanban_record_body">
                                        <div class="row">
                                            <div class="col-12">
                                                <small>Created: <field name="create_date" /></small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Batch Export Search View -->
        <record id="view_stockpilot_batch_export_search" model="ir.ui.view">
            <field name="name">stockpilot.batch.export.search</field>
            <field name="model">stockpilot.batch.export</field>
            <field name="arch" type="xml">
                <search string="Search Batch Exports">
                    <field name="name" />
                    <field name="config_id" />
                    <field name="company_id" />
                    <group expand="0" string="Group By">
                        <filter string="Company" name="group_company" context="{'group_by': 'company_id'}" />
                        <filter string="Configuration" name="group_config" context="{'group_by': 'config_id'}" />
                        <filter string="Date" name="group_date" context="{'group_by': 'create_date:day'}" />
                    </group>
                </search>
            </field>
        </record>

        <!-- Batch Export Action -->
        <record id="action_stockpilot_batch_export" model="ir.actions.act_window">
            <field name="name">Batch Exports</field>
            <field name="res_model">stockpilot.batch.export</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first batch export!
                </p>
                <p>
                    Batch exports allow you to export multiple products to StockPilot in a single job,
                    with detailed logging and error handling.
                </p>
            </field>
        </record>

        <!-- Menu Items -->
        <menuitem
      id="menu_stockpilot_batch_export"
      name="Batch Exports"
      parent="menu_stockpilot_main"
      action="action_stockpilot_batch_export"
      sequence="10"
    />
    </data>
</odoo>
