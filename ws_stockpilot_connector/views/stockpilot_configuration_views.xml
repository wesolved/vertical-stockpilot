<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="view_stockpilot_configuration_tree" model="ir.ui.view">
            <field name="name">stockpilot.configuration.view.tree</field>
            <field name="model">stockpilot.configuration</field>
            <field name="arch" type="xml">
                <tree import="false">
                    <field name="name" />
                    <field name="api_client_id" />
                    <field name="api_client_secret" />
                    <field name="base_url" />
                    <field name="environment" />
                    <field name="active" invisible="1" />

                    <button
             name="toggle_active"
             type="object"
             icon="fa-archive"
             string="Archive"
             attrs="{'invisible': [('active', '=', False)]}"
             class="oe_stat_button"
           />

                    <button
             name="unlink"
             type="object"
             class="oe_stat_button"
             icon="fa-trash"
             string="Delete"
             attrs="{'invisible': [('active', '=', True)]}"
           />
                </tree>
            </field>
        </record>

        <record id="view_stockpilot_configuration_form" model="ir.ui.view">
            <field name="name">stockpilot.configuration.form</field>
            <field name="model">stockpilot.configuration</field>
            <field name="arch" type="xml">
                <form string="Stockpilot Configuration">
                     <sheet>
                        <group>
                            <field name="name" string="Configuration Name" required="1" />
                            <field name="company_id" />
                            <field name="api_client_id" />
                            <field name="api_client_secret" />
                            <field name="base_url" />
                            <field name="environment" />
                        </group>
                        <div class="oe_button_box" name="button_box">
                            <button name="test_connection" string="Test Connection" type="object" class="oe_stat_button btn-primary" />
                            <button name="import_orders" string="Import Orders" type="object" class="oe_stat_button btn-primary" />
                            <button name="import_stock" string="Import Stock" type="object" class="oe_stat_button btn-primary" />
                            <button name="export_products" string="Export Products" type="object" class="oe_stat_button btn-primary" />
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_stockpilot_configuration" model="ir.actions.act_window">
        <field name="name">Stockpilot Configs</field>
        <field name="res_model">stockpilot.configuration</field>
        <field name="view_mode">tree,form</field>
    </record>

        <menuitem
      id="menu_stockpilot_main"
      name="Stockpilot"
      sequence="100"
      action="action_stockpilot_configuration"
      web_icon="ws_stockpilot_connector,static/description/icon.png"
    />
    </data>
</odoo>
