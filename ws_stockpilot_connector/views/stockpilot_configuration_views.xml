<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <!-- Form View -->
        <record id="view_stockpilot_configuration_form" model="ir.ui.view">
            <field name="name">stockpilot.configuration.form</field>
            <field name="model">stockpilot.configuration</field>
            <field name="arch" type="xml">
                <form string="Stockpilot Configuration">
                     <sheet>
                        <group>
                            <field name="company_id" options="{'no_open': True, 'no_create': True}" attrs="{'readonly': [('id', '!=', False)]}" />
                            <field name="api_client_id" />
                            <field name="api_client_secret" />
                            <field name="base_url" />
                            <field name="environment" />
                        </group>
                        <div class="oe_button_box" name="button_box">
                            <button name="test_connection" string="Test Connection" type="object" class="oe_stat_button btn-primary" />
                            <button name="import_orders" string="Import Orders" type="object" class="oe_stat_button btn-primary" />
                            <button name="import_stock" string="Import Stock" type="object" class="oe_stat_button btn-primary" />
                            <button name="export_products" string="Export Products" type="object" class="oe_stat_button btn-primary" />
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_stockpilot_configuration" model="ir.actions.act_window">
            <field name="name">Stockpilot Configuration</field>
            <field name="res_model">stockpilot.configuration</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_stockpilot_configuration_form" />
            <field name="target">current</field>
            <field name="binding_model_id" ref="model_stockpilot_configuration" />
            <field name="binding_type">action</field>
        </record>

        <record id="action_server_load_configuration" model="ir.actions.server">
            <field name="name">Load Stockpilot Configuration</field>
            <field name="model_id" ref="model_stockpilot_configuration" />
            <field name="state">code</field>
            <field name="code">
model = env['stockpilot.configuration']
action = model._get_default_config()._get_config_action()
            </field>
        </record>

        <menuitem
        id="menu_stockpilot_main"
        name="Stockpilot"
        sequence="100"
        action="action_server_load_configuration"
        web_icon="ws_stockpilot_connector,static/description/icon.png"
        />
    </data>
</odoo>
