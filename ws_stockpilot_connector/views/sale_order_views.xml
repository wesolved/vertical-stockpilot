<odoo>
    <record id="view_quotation_tree_with_onboarding" model="ir.ui.view">
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding" />
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <field name="stockpilot_order_id" />
                </field>
            </field>
        </record>
    <!-- create filter on stockpilot orders -->
    <record id="view_sales_order_filter" model="ir.ui.view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter" />
        <field name="arch" type="xml">
            <search>
                <field name="stockpilot_order_id" string="Stockpilot Order Number" />
                <field name="stockpilot_order_id" string="Woo Order Ref" />
                <filter string="Stockpilot Orders" name="stock_pilot_orders" domain="[('stockpilot_order_id', '!=', False)]" />
            </search>
        </field>
    </record>
</odoo>
